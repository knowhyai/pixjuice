{
  "name": "pixjuice",
  "version": "0.1.0",
  "private": true,
  "description": "Recolor, preview, and export pixel skill effects for games.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/check-sfx-presets.mjs && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:sfx": "node scripts/check-sfx-presets.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "gifenc": "^1.0.3",
    "jsfxr": "^1.4.1",
    "pixelfx": "github:patch-gg/pixelfx"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
