# PixJuice public config. Copy to .env for local builds. All values are optional.
# Empty means the hook is not rendered. Do not put secrets here — these ship in HTML.

# Canonical origin (scheme + host, no path). Default: https://pixjuice.pages.dev
PUBLIC_SITE_URL=

# Search-console verification tokens (the content value only, not the whole tag).
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=

# Analytics. Leave blank to ship no tracker.
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
PUBLIC_PLAUSIBLE_DOMAIN=

# Footer newsletter link. https URL. Hidden when empty.
PUBLIC_NEWSLETTER_URL=
